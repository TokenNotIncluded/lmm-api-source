    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.1",
    "react-icons": "^5.7.0",
    "react-top-loading-bar": "^3.0.2",
    "shaders": "4.0.7",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "stream-markdown-parser": "^1.2.25",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
