{
  "name": "@lmm/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "shaders:connect": "shaders connect --framework react --no-install",
    "shaders:install": "shaders install 4740184 --yes && node scripts/sync-shader-compositions.mjs",
    "shaders:update": "shaders update && node scripts/sync-shader-compositions.mjs",
    "shaders:sync": "node scripts/sync-shader-compositions.mjs",
    "shaders:check": "node scripts/sync-shader-compositions.mjs --check",
    "shaders:open": "shaders open",
    "shaders:mcp": "shaders install-mcp -a codex",
    "dev": "rsbuild dev",
    "dev:debug": "LMM_ENABLE_PERSONA_DEBUG=1 rsbuild dev",
    "build": "node scripts/sync-shader-compositions.mjs --check && VITE_REACT_APP_VERSION=${VITE_REACT_APP_VERSION:-$(git rev-parse --short HEAD 2>/dev/null || echo 'dev')} rsbuild build",
    "bundle:check": "node scripts/check-initial-bundle.mjs",
    "build:check": "node scripts/sync-shader-compositions.mjs --check && tsgo -b && rsbuild build",
    "test": "node --test scripts/extore-callback.test.mjs && bun scripts/test-serial.mjs",
    "typecheck": "tsgo -b",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint -c .oxlintrc.json . --fix",
    "preview": "rsbuild preview",
    "format:check": "node scripts/format-with-protected-headers.mjs --check",
    "format": "node scripts/format-with-protected-headers.mjs --write",
    "copyright:check": "node scripts/add-copyright.mjs --check",
    "copyright": "node scripts/add-copyright.mjs",
    "i18n:sync": "node scripts/sync-i18n.mjs",
    "knip": "knip",
    "smoke:dashboard": "node scripts/read-only-dashboard-smoke.mjs",
    "blackbox:debug": "node scripts/debug-persona-blackbox.mjs"
  },
  "dependencies": {
