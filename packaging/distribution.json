{
  "schema_version": 1,
  "common": [
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-LICENSES.md"
  ],
  "components": {
    "core": {
      "package": "lmm-core",
      "binaries": [
        "lmm-core"
      ],
      "platforms": [
        "linux-amd64",
        "linux-arm64"
      ],
      "resources": [
        "config/core.example.toml",
        "docs/filesystem-layout.md"
      ]
    },
    "extensions": {
      "package": "lmm-extensions",
      "binaries": [
        "lmm-extensions"
      ],
      "platforms": [
        "linux-amd64",
        "linux-arm64",
        "linux-musl-amd64",
        "linux-musl-arm64"
      ],
      "resources": [
        "config/extensions.example.toml",
        "docs/filesystem-layout.md",
        "config/legal/site.example.toml",
        "docs/legal/README.md",
        "config/legal/templates/zh-CN/user-agreement.md",
        "config/legal/templates/zh-CN/privacy-policy.md",
        "config/legal/templates/zh-CN/refund-policy.md",
        "config/legal/templates/en/user-agreement.md",
        "config/legal/templates/en/privacy-policy.md",
        "config/legal/templates/en/refund-policy.md",
        "config/legal/templates/zh-TW/user-agreement.md",
        "config/legal/templates/zh-TW/privacy-policy.md",
        "config/legal/templates/zh-TW/refund-policy.md",
        "packaging/extore-plugin.json",
        "docs/extore.md"
      ],
      "libraries": [
        "lib/extore/libextore_plugin_host.so",
        "lib/extore/libextore_commerce_plugin.so"
      ],
      "build_resources": [
        "licenses/extore/LICENSE",
        "licenses/extore/THIRD-PARTY-NATIVE.txt",
        "licenses/extore/THIRD-PARTY-NATIVE.json",
        "licenses/purego/LICENSE",
        "licenses/purego/GO-LICENSE"
      ]
    },
    "cli": {
      "package": "lmm",
      "binaries": [
        "lmm"
      ],
      "platforms": [
        "linux-amd64",
        "linux-arm64",
        "macos-amd64",
        "macos-arm64",
        "windows-amd64",
        "windows-arm64"
      ],
      "resources": [
        "apps/cli/NOTICE",
        "apps/cli/third_party/magpie/LICENSE",
        "apps/cli/third_party/magpie/NOTICE.md"
      ]
    },
    "web": {
      "package": "lmm-web",
      "binaries": [],
      "platforms": [
        "any"
      ],
      "resources": []
    }
  }
}
