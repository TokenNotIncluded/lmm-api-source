{
  "schema_version": 1,
  "common": [
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-LICENSES.md"
  ],
  "components": {
    "core": {
      "package": "lmm-core",
      "binaries": [
        "lmm-core"
      ],
      "platforms": [
        "linux-amd64",
        "linux-arm64"
      ],
      "resources": [
        "config/core.example.toml",
        "docs/filesystem-layout.md"
      ]
    },
    "extensions": {
      "package": "lmm-extensions",
      "binaries": [
        "lmm-extensions"
      ],
      "platforms": [
        "linux-amd64",
        "linux-arm64"
      ],
      "resources": [
        "config/extensions.example.toml",
        "docs/filesystem-layout.md",
        "config/legal/site.example.toml",
        "docs/legal/README.md",
        "config/legal/templates/zh-CN/user-agreement.md",
        "config/legal/templates/zh-CN/privacy-policy.md",
        "config/legal/templates/zh-CN/refund-policy.md",
        "config/legal/templates/en/user-agreement.md",
        "config/legal/templates/en/privacy-policy.md",
        "config/legal/templates/en/refund-policy.md"
      ],
      "optional_extore_plugin": {
        "targets": {
          "linux-amd64": "x86_64-unknown-linux-gnu",
          "linux-arm64": "aarch64-unknown-linux-gnu"
        },
        "files": {
          "libexec/lmm-extore-host": {
            "input": "lmm-extore-host",
            "mode": 493,
            "shared": false
          },
          "lib/extore/libextore_zplugin.so": {
            "input": "libextore_zplugin.so",
            "mode": 420,
            "shared": true
          }
        },
        "resources": [
          "third_party/extore/LICENSE",
          "docs/extore.md"
        ]
      }
    },
    "cli": {
      "package": "lmm",
      "binaries": [
        "lmm"
      ],
      "platforms": [
        "linux-amd64",
        "linux-arm64",
        "macos-amd64",
        "macos-arm64",
        "windows-amd64",
        "windows-arm64"
      ],
      "resources": [
        "apps/cli/NOTICE",
        "apps/cli/third_party/magpie/LICENSE",
        "apps/cli/third_party/magpie/NOTICE.md"
      ]
    },
    "web": {
      "package": "lmm-web",
      "binaries": [],
      "platforms": [
        "any"
      ],
      "resources": []
    }
  }
}
