{
  "name": "api.lmm.best",
  "version": "0.1.6",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:go": "cd services/extensions && go run ./cmd/extensions",
    "dev:web": "bun run --filter @lmm/web dev",
    "build:go": "mkdir -p services/extensions/out && cd services/extensions && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o out/lmm-extensions ./cmd/extensions",
    "build:web": "bun run --filter @lmm/web build",
    "test:go": "cd services/extensions && go test -race ./... -count=1",
    "test:web": "bun run --filter @lmm/web test",
    "format:go": "cd services/extensions && go fmt ./...",
    "format:web": "bun run --filter @lmm/web format",
    "format-check:go": "bash scripts/check-go-format.sh services/extensions",
    "format-check:web": "bun run --filter @lmm/web format:check",
    "lint:go": "cd services/extensions && go vet ./...",
    "lint:web": "bun run --filter @lmm/web lint",
    "typecheck:go": "cd services/extensions && go test -run '^$' ./...",
    "typecheck:web": "bun run --filter @lmm/web typecheck",
    "waffo:pancake:smoke": "node scripts/waffo-pancake-smoke.mjs",
    "dev:core": "cd services/core && cargo run --locked",
    "build:core": "cd services/core && cargo build --locked --release",
    "test:core": "cd services/core && cargo test --locked --all-targets",
    "format:core": "cd services/core && cargo fmt --all",
    "format-check:core": "cd services/core && cargo fmt --all --check",
    "lint:core": "cd services/core && cargo clippy --locked --all-targets -- -D warnings",
    "typecheck:core": "cd services/core && cargo check --locked --all-targets",
    "dev:extensions": "bun run dev:go",
    "build:extensions": "bun run build:go",
    "test:extensions": "bun run test:go",
    "format:extensions": "bun run format:go",
    "format-check:extensions": "bun run format-check:go",
    "lint:extensions": "bun run lint:go"
  },
  "devDependencies": {
    "@waffo/pancake-ts": "0.28.0"
  },
  "overrides": {
    "brace-expansion": "5.0.13",
    "dompurify": "3.4.17",
    "fast-uri": "4.2.3",
    "hono": "4.13.18",
    "ip-address": "10.7.6",
    "js-cookie": "3.0.8",
    "mermaid": "12.3.0",
    "minimist": "1.2.8",
    "postcss": "8.5.32",
    "qs": "6.17.1",
    "uuid": "14.0.3",
    "katex": "0.19.1"
  },
  "packageManager": "bun@1.3.14"
}
